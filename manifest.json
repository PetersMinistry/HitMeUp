{
  "manifest_version": 2,
  "name": "HitMeUp Reminder",
  "version": "1.0.3",
  "author": "Peter Moreno",
  "developer": {
    "name": "Peter Moreno"
  },
  "description": "Set reminders on emails so follow-ups do not get lost",
  "browser_specific_settings": {
    "gecko": {
      "id": "hitmeup-reminder@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesTags",
    "alarms",
    "notifications",
    "storage",
    "menus"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_title": "HitMeUp Reminder",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "reminder_popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "browser_style": false
  },
  "background": {
    "scripts": ["background.js"]
  }
}
